# ===================================================================
# DocForge Frontend Environment Variables
# Copy to .env.local for local overrides
# ===================================================================

# Backend FastAPI URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical Public Site URL (REQUIRED for production deployment)
# Configure with your actual verified canonical production domain.
# Used for:
# - <link rel="canonical"> tags
# - OpenGraph og:url and Twitter card URLs
# - sitemap.xml loc entries
# - robots.txt sitemap reference
# WARNING: If left unset, falls back to https://docforge.com as a placeholder.
# Example: NEXT_PUBLIC_SITE_URL=https://your-confirmed-domain.com
NEXT_PUBLIC_SITE_URL=https://docforge.com
