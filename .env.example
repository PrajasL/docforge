# ===================================================================
# DocForge Platform - Environment Variables
# Copy this file to .env and adjust values for your environment.
# ===================================================================

# Application Mode
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical Public Site URL (REQUIRED for production deployment)
# Used for canonical link tags, OpenGraph og:url, sitemap.xml, and robots.txt
# Default fallback if unset: https://docforge.com
NEXT_PUBLIC_SITE_URL=https://docforge.com


# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=docforge
POSTGRES_PASSWORD=docforge_dev
POSTGRES_DB=docforge

# Redis Cache & Broker
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO local / Cloudflare R2 / AWS S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_INPUTS=docforge-inputs
STORAGE_BUCKET_OUTPUTS=docforge-outputs
STORAGE_USE_SSL=false
STORAGE_REGION=us-east-1

# Processing Limits
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_JOB=20
MAX_AGGREGATE_JOB_SIZE_MB=250
DEFAULT_JOB_TTL_SECONDS=7200

# Rate Limiting (Redis-backed atomic sliding window)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_JOB_CREATION_LIMIT=20
RATE_LIMIT_JOB_CREATION_WINDOW=60
RATE_LIMIT_UPLOAD_LIMIT=60
RATE_LIMIT_UPLOAD_WINDOW=60
RATE_LIMIT_GENERAL_LIMIT=120
RATE_LIMIT_GENERAL_WINDOW=60
TRUSTED_PROXIES=127.0.0.1,::1,localhost

# Antivirus Scanning (ClamAV TCP daemon)
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10.0
CLAMAV_FAIL_CLOSED=true

# Security Headers
ENABLE_HSTS=false
