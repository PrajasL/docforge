# ===================================================================
# DocForge Production Environment Configuration (.env.production)
# IMPORTANT: Never commit actual production secrets to version control.
# Copy this template to .env.production and provide strong generated secrets.
# ===================================================================

# -------------------------------------------------------------------
# Application Runtime & Core Settings
# -------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
VERSION=1.0.0
PROJECT_NAME="DocForge"
LOG_LEVEL=INFO

# -------------------------------------------------------------------
# Domain & Security
# -------------------------------------------------------------------
# Production canonical site domain and reverse proxy settings
APP_DOMAIN=docforge.example.com
NEXT_PUBLIC_SITE_URL=https://docforge.example.com
NEXT_PUBLIC_API_URL=/api/v1

# Strong cryptographic secret (minimum 32 random characters: openssl rand -hex 32)
SECRET_KEY=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY

# Allowed CORS origins (comma-separated if multiple)
CORS_ORIGINS=["https://docforge.example.com"]

# Trust X-Forwarded-For headers ONLY from the reverse proxy container or CIDR
TRUSTED_PROXIES=["127.0.0.1","172.16.0.0/12","10.0.0.0/8"]

# Rate Limiting (Requests per minute window per IP/client)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_BURST_PER_MINUTE=200
RATE_LIMIT_JOB_CREATION_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=40

# Upload Security Limits
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_UPLOAD_PAGES=500

# -------------------------------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------------------------------
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=docforge_app
POSTGRES_PASSWORD=GENERATE_STRONG_DATABASE_PASSWORD_HERE
POSTGRES_DB=docforge_prod

# -------------------------------------------------------------------
# Cache & Message Broker (Redis)
# -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_WORKER_PING_TIMEOUT=1.5

# -------------------------------------------------------------------
# Production Storage (Cloudflare R2 or AWS S3)
# -------------------------------------------------------------------
# Set to 'r2' for Cloudflare R2, 's3' for AWS S3, or 'minio' for self-hosted MinIO
STORAGE_PROVIDER=r2

# For Cloudflare R2:
# Endpoint URL format: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=your_r2_access_key_id
STORAGE_SECRET_KEY=your_r2_secret_access_key
STORAGE_USE_SSL=true

# Bucket Names
STORAGE_BUCKET_INPUTS=docforge-inputs
STORAGE_BUCKET_OUTPUTS=docforge-outputs

# (Optional) Public custom domain for R2 download CDN (e.g., https://cdn.docforge.example.com)
# STORAGE_PUBLIC_DOMAIN=https://cdn.docforge.example.com

# (Optional) Presigned URL endpoint override (if external clients connect via different URL than backend)
# STORAGE_PRESIGNED_ENDPOINT_OVERRIDE=https://storage.docforge.example.com

# -------------------------------------------------------------------
# Antivirus Scanner (ClamAV)
# -------------------------------------------------------------------
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15.0
CLAMAV_FAIL_CLOSED=true

# -------------------------------------------------------------------
# Telemetry & Monitoring (Sentry - Optional)
# -------------------------------------------------------------------
# Leave blank to disable telemetry. When provided, strict PII & file scrubbers protect telemetry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
