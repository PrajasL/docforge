# Environment Variables & Secrets
.env
.env.*
.env*.local
!.env.example
!.env.production.example
!frontend/.env.example

# Credentials & Keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/

# Node & Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
frontend/out/
frontend/build/
.yarn/
*.tsbuildinfo
next-env.d.ts

# Testing, Scratch & Temporary Artifacts
playwright-report/
test-results/
coverage/
frontend/coverage/
test_artifacts/
tests/e2e/test_artifacts/
scratch/
backend/tests/scratch/
rotate_*.pdf
rotate_*.txt

# Celery Beat
celerybeat-schedule*
/tmp/celerybeat-schedule*

# Local Databases & Storage
*.sqlite
*.sqlite3
*.db
uploads/
storage/
storage_data/
storage_prod_data/

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

